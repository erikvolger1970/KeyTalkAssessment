@page "/userlist"
@rendermode InteractiveAuto
@using MudBlazor

@if (UserData is null)
{
    <p>No user data</p>
}
else
{
    <MudDataGrid Items="@UserData" ondblclick="HandleDoubleClick">
        <Columns>
            <PropertyColumn Property="x => x.Id" Title="ID" />
            <PropertyColumn Property="x => x.Name" />
            <PropertyColumn Property="x => x.Key" Title="SSL Key (fictional)" />        
            <PropertyColumn Property="x => x.CompanyName" />
        </Columns>
    </MudDataGrid>
}

@code {
    private IEnumerable<User>? UserData;

    protected override async Task OnInitializedAsync()
    {
        // todo: read from rest api
        UserData =
        [
            new User(1, "Alice", Guid.NewGuid(), "Company A"),
            new User(2, "Bob", Guid.NewGuid(), "Company B"),
            new User(3, "Charlie", Guid.NewGuid(), "Company C"),
            new User(4, "Donald", Guid.NewGuid(), "Company C"),
        ];
    }

    private void HandleDoubleClick(User user)
    {
        // Handle double click event
    }
}
